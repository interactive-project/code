{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interactive-project/code/blob/main/schemas/code-activity.v1.schema.json",
  "title": "Portable educational code workspace v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "prompt": {
      "$ref": "https://github.com/interactive-project/content-node/blob/main/schemas/content-node.v1.schema.json"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+-]{0,31}$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+-]{0,31}$"
          },
          "encoding": {
            "const": "utf-8"
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "editable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "path",
          "encoding",
          "text",
          "editable"
        ],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rename": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      },
      "required": [
        "create",
        "rename",
        "delete"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "prompt",
    "language",
    "entrypoint",
    "files",
    "permissions"
  ],
  "additionalProperties": false
}
